                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Orders (Redis + PostgreSQL)",
      "description": "Order flow: Idempotency-Key in Redis, ReentrantLock per product, pessimistic row lock in PostgreSQL, Kafka event after commit. Run in order - 'Replay' depends on 'Create order'.",
      "item": [
        {
          "name": "Create order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "description": "First call with a fresh Idempotency-Key. Expect 201 + Location header. The key and the returned orderRef are saved for the next requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"product\": \"widget\",\n  \"quantity\": 2,\n  \"amount\": 19.98\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh key per run so the first call is always a genuine create.",
                  "pm.collectionVariables.set('idemKey', 'idem-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('returns an order ref', function () {",
                  "    pm.expect(body.orderRef).to.match(/^ORD-/);",
                  "});",
                  "",
                  "pm.test('is not a replay', function () {",
                  "    pm.expect(body.replayed).to.eql(false);",
                  "});",
                  "",
                  "pm.test('status is NEW', function () {",
                  "    pm.expect(body.status).to.eql('NEW');",
                  "});",
                  "",
                  "pm.test('Location header points at the order', function () {",
                  "    pm.expect(pm.response.headers.get('Location')).to.include(body.orderRef);",
                  "});",
                  "",
                  "pm.collectionVariables.set('orderRef', body.orderRef);"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay same Idempotency-Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "description": "Same key, same payload. Redis short-circuits this: expect 200 (not 201), replayed=true, and the SAME orderRef - no second row in PostgreSQL.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"product\": \"widget\",\n  \"quantity\": 2,\n  \"amount\": 19.98\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200, not 201', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('flagged as a replay', function () {",
                  "    pm.expect(body.replayed).to.eql(true);",
                  "});",
                  "",
                  "pm.test('returns the ORIGINAL order, no duplicate created', function () {",
                  "    pm.expect(body.orderRef).to.eql(pm.collectionVariables.get('orderRef'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get order by ref",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderRef}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderRef}}"
              ]
            },
            "description": "Reads the order back through the NAMED entity graph (@NamedEntityGraph on OrderEntity), so the stock row comes back in the same SELECT."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('matches the created order', function () {",
                  "    pm.expect(body.orderRef).to.eql(pm.collectionVariables.get('orderRef'));",
                  "    pm.expect(body.product).to.eql('widget');",
                  "    pm.expect(body.quantity).to.eql(2);",
                  "});",
                  "",
                  "// If the entity graph were missing, the association would still be a lazy proxy",
                  "// after the transaction closed and this endpoint would 500 with",
                  "// LazyInitializationException instead of returning a stock block.",
                  "pm.test('entity graph fetched the stock association', function () {",
                  "    pm.expect(body.stock, 'stock should be eagerly fetched').to.be.an('object');",
                  "    pm.expect(body.stock.product).to.eql('widget');",
                  "    pm.expect(body.stock.available).to.be.a('number');",
                  "    pm.expect(body.stock.reserved).to.be.at.least(2);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List orders by customer",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders?customerId={{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ],
              "query": [
                {
                  "key": "customerId",
                  "value": "{{customerId}}"
                }
              ]
            },
            "description": "Most recent 20 orders, loaded via an AD-HOC entity graph (@EntityGraph(attributePaths)). One query for the page instead of 1 + N."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('returns an array containing our order', function () {",
                  "    pm.expect(body).to.be.an('array').that.is.not.empty;",
                  "    const refs = body.map(function (o) { return o.orderRef; });",
                  "    pm.expect(refs).to.include(pm.collectionVariables.get('orderRef'));",
                  "});",
                  "",
                  "pm.test('every row carries its stock (no N+1, no lazy proxy)', function () {",
                  "    body.forEach(function (o) {",
                  "        pm.expect(o.stock, 'stock on ' + o.orderRef).to.be.an('object');",
                  "        pm.expect(o.stock.product).to.eql(o.product);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
