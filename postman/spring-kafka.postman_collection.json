{
  "info": {
    "_postman_id": "0f6d2b1a-6a2c-4c1e-9a3f-5b7c8d9e0a11",
    "name": "spring-kafka",
    "description": "Smoke tests for the Spring Boot 4 + Kafka sample. Run the folder in order: health -> hello -> publish -> last consumed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "message",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": ["{{baseUrl}}"],
          "path": ["actuator", "health"]
        },
        "description": "Actuator health. Also confirms the app is up before the other tests run."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('status is UP', function () {",
              "    pm.expect(pm.response.json().status).to.eql('UP');",
              "});",
              "",
              "pm.test('responds under 2s', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /hello",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/hello",
          "host": ["{{baseUrl}}"],
          "path": ["hello"]
        },
        "description": "Plain greeting from HelloController. No Kafka involved."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('returns the greeting', function () {",
              "    pm.expect(pm.response.text()).to.eql('Hello from Spring Boot 4 + Kafka');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /hello (publish)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/hello?message={{message}}",
          "host": ["{{baseUrl}}"],
          "path": ["hello"],
          "query": [{ "key": "message", "value": "{{message}}" }]
        },
        "description": "Publishes a unique message to hello-topic. The message is generated in the pre-request script and saved as the {{message}} variable so the next request can assert on it."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Unique payload per run so the assertion below can't pass on a stale message.",
              "pm.collectionVariables.set('message', 'postman-' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('content type is JSON', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test('status field is sent', function () {",
              "    pm.expect(body.status).to.eql('sent');",
              "});",
              "",
              "pm.test('echoes the message we published', function () {",
              "    pm.expect(body.message).to.eql(pm.collectionVariables.get('message'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /hello/last (consumed)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/hello/last",
          "host": ["{{baseUrl}}"],
          "path": ["hello", "last"]
        },
        "description": "Asserts the @KafkaListener actually consumed the message published by the previous request. Consumption is asynchronous, so this request retries itself for up to ~5 seconds."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const expected = pm.collectionVariables.get('message');",
              "const attempt = Number(pm.collectionVariables.get('lastAttempt') || 0);",
              "const MAX_ATTEMPTS = 10;",
              "",
              "pm.test('status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const consumed = pm.response.json().lastConsumed;",
              "",
              "if (consumed !== expected && attempt < MAX_ATTEMPTS) {",
              "    // Kafka consumption is async - re-run this request.",
              "    // Pair with a runner delay (newman --delay-request 300) to space the retries out.",
              "    pm.collectionVariables.set('lastAttempt', attempt + 1);",
              "    pm.execution.setNextRequest('GET /hello/last (consumed)');",
              "    console.log('Not consumed yet, retry ' + (attempt + 1) + '/' + MAX_ATTEMPTS);",
              "} else {",
              "    pm.collectionVariables.set('lastAttempt', 0);",
              "    pm.test('consumer received the published message', function () {",
              "        pm.expect(consumed).to.eql(expected);",
              "    });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /hello/unknown (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/hello/does-not-exist",
          "host": ["{{baseUrl}}"],
          "path": ["hello", "does-not-exist"]
        },
        "description": "Negative case - unmapped path should not return 200."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 404', function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
